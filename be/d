#!/bin/bash
# Dev backend for this worktree, restarting itself on every save.
#
# The twin of fe/s, and deliberately not be/s. That one is the launcher — it
# supervises a *packaged* runtime, does not watch source, and is what the :3010
# backend is; picking up a change there still means restarting it by hand. This
# is the development sibling, and the two want different names because they do
# different things to the same port.
#
# Between this and fe/s a change becomes visible without anyone merging it
# anywhere: dx rebuilds the frontend it watches, `node --watch` restarts the
# backend it watches, and both are the ones sitting in the tree being edited.
cd "$(dirname "$0")" || exit 1

# shellcheck source=../scripts/dev-ports.sh
. ../scripts/dev-ports.sh

# Separate state per worktree, for the same reason each gets its own build
# directory: four backends writing one job-state.json would have one worktree's
# run clear another's cursors, and the store gives no sign of whose entry it
# was. ~/rn keeps the real config, so the install a person actually uses is
# untouched by whatever the other panes are doing.
worktree="$(basename "$(cd .. && pwd)")"
if [ "$worktree" != "rn" ]; then
    state="$HOME/.cache/rn-state-$worktree"
    mkdir -p "$state"
    export RN_SETTINGS_PATH="$state/settings.json"
    export RN_HISTORY_PATH="$state/history.json"
    export RN_JOB_STATE_PATH="$state/job-state.json"
    export RN_JOB_RUNS_PATH="$state/job-runs.json"
    # Webhooks too, and this one bites hardest if it is forgotten: a webhook
    # made while testing in a worktree would otherwise be a live endpoint on the
    # install the person actually uses.
    export RN_WEBHOOKS_PATH="$state/webhooks.json"
    # And the credentials file, now that a page can write it. Without this a
    # worktree saving a test credential would rewrite the real one.
    export RN_CREDENTIALS_PATH="$state/credentials"
    # Per-job overrides, so a ceiling raised while testing does not follow the
    # person to the install they actually run.
    export RN_JOB_OVERRIDES_PATH="$state/job-overrides.json"
    # The tracker's links. Sharing this one would be the worst of the set: a
    # link minted here resolves against whichever store the tracker on that
    # port loaded, so a shared file means a worktree's test links answering on
    # the real install — and, the other way, a real link 404ing because a
    # worktree pruned it.
    export RN_TRACKER_STORE_PATH="$state/link-tracking.jsonl"
    # And the send job's markers, which decide whether a recipient gets mail.
    # Sharing this one is the only entry here that could reach a person: a
    # worktree test send would write markers under the real install, so a later
    # genuine send to the same list would find them already attempted and mail
    # nobody. The reverse is worse — a worktree that pruned or lost the file
    # could mail a list the real install had already sent to.
    export RN_TRACKER_SENT_PATH="$state/link-sends.jsonl"
    # Mail rules, for the reason webhooks are here: a rule made while testing
    # would otherwise start holding an IMAP connection open against the install
    # somebody actually uses, and reporting their mail onto its pages.
    export RN_MAIL_RULES_PATH="$state/mail-rules.json"
    # Watched pages, for the same reason as the mail rules above: a page added
    # while testing would otherwise be fetched hourly by the install somebody
    # actually uses, and report its changes onto their pages.
    export RN_WATCH_PAGES_PATH="$state/watch-pages.json"
    # The last connection test. Shared, a worktree pressing the button would
    # rewrite what the real install last proved — and a test against a bench
    # server would read on that install's page as its own account working.
    export RN_MAIL_TEST_PATH="$state/mail-test.json"
fi

echo "backend for $worktree on http://127.0.0.1:$BACKEND_PORT (hooks :$BACKEND_HOOKS_PORT, tracker :$BACKEND_TRACKER_PORT)"

# server.ts, not main.ts. `npm run dev` watches main.ts, which prints the boot
# banner and exits — a watcher on a program that does not listen, which looks
# like a backend that died a second after starting. server.ts is the half that
# binds the port.
exec npm run dev:serve "$@"
