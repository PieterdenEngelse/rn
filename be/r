#!/bin/bash
# Restart the installed backend — the one systemd holds on :3010.
#
# The third of the four, and the one that was missing. `fe/s` serves a
# worktree's frontend, `be/d` runs a worktree's dev backend, `be/s` reaches the
# launcher. None of them restarts the *installed* backend, so the only way to do
# it was to type `systemctl --user restart rn-backend`, which is long enough
# that be/s got briefly rewritten to be exactly that line. Reasonable thing to
# want, wrong place to put it: be/s is the only route to the launcher, and
# overloading it costs --status, --print-env and the scratch backend in
# docs/dev.md their script.
#
# It restarts the service, never this worktree. There is one rn-backend.service
# and it runs ~/rn's launcher, so `be/r` from ~/cc restarts ~/rn's backend —
# which is the right answer, since that is the install a person actually uses,
# but it is not the obvious one and the output below says whose process it is.
set -u
unit=rn-backend.service

if ! command -v systemctl >/dev/null 2>&1 ||
    ! systemctl --user cat "$unit" >/dev/null 2>&1; then
    echo "be/r: no $unit on this machine, so there is no installed backend to restart."
    echo "be/r: a worktree's own dev backend is be/d, and a launcher you started"
    echo "be/r: yourself is stopped where you started it."
    exit 1
fi

systemctl --user restart "$unit" || exit 1

# What a restart is actually being asked to prove: that it came back, on which
# runtime, and answering. Reporting "restarted" and stopping there is how a
# launcher that died two seconds later reads as a success — and the runtime is
# the specific thing you restart for after scripts/install-node.sh, since the
# old process keeps executing the binary it opened however many times the file
# underneath it is replaced.
for _ in $(seq 1 20); do
    main=$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null)
    [ -n "$main" ] && [ "$main" != "0" ] && child=$(pgrep -P "$main" | head -1)
    [ -n "${child:-}" ] && break
    sleep 0.5
done

if [ -z "${child:-}" ]; then
    echo "be/r: restarted, but no Node child appeared within 10s."
    systemctl --user status "$unit" --no-pager 2>/dev/null | sed -n '1,6p'
    exit 1
fi

runtime=$(readlink -f "/proc/$child/exe" 2>/dev/null)
echo "be/r: $unit restarted — launcher pid $main, node pid $child"
[ -n "$runtime" ] && echo "be/r: runtime ${runtime/#$HOME/\~} ($("$runtime" --version 2>/dev/null))"

# Read the ports off the process rather than naming them. 3010 and 3011 are
# only true for the ~/rn slot, and a copy of that mapping here would be the
# second copy scripts/dev-ports.sh exists to prevent.
#
# Waited for, not sampled. The child appears a beat before it binds, so asking
# once at the moment it shows up reports "listening on nothing" for a backend
# that is seconds from serving — which reads as a failed restart and is not one.
for _ in $(seq 1 20); do
    ports=$(ss -lptnH 2>/dev/null | awk -v p="pid=$child," '$0 ~ p {print $4}' |
        sed 's/.*://' | sort -un | tr '\n' ' ')
    [ -n "${ports// /}" ] && break
    sleep 0.5
done

if [ -n "${ports// /}" ]; then
    echo "be/r: listening on ${ports% }"
else
    echo "be/r: up, but bound to nothing after 10s — read"
    echo "be/r:     systemctl --user status $unit"
    exit 1
fi
