{
  "name": "rn-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start:sealed": "./runtime/bin/node --env-file-if-exists=.env src/main.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "start:sealed:win": "runtime\\bin\\node.exe --env-file-if-exists=.env src/main.ts",
    "params:build": "node tools/gen-params.ts",
    "serve": "node --env-file-if-exists=.env src/server.ts",
    "probe:runtimes": "./runtime/bin/node tools/probe-runtime.cjs && ./runtime-bun/bin/bun run tools/probe-runtime.cjs && ./runtime-deno/bin/deno run -A tools/probe-runtime.cjs",
    "types:build": "cd ../shared && cargo run --quiet --bin gen-types"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^24.0.0"
  }
}
