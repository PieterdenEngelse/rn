# Copy to .env and edit. .env is gitignored; this file is the key reference.
# Every key added to .env must be added here too, with a safe placeholder.

# error | warn | info | debug
LOG_LEVEL=info

# Automation safety switch. Anything other than the exact string "false"
# means dry-run. Leave it on until a job is proven.
DRY_RUN=true
