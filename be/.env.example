# Copy to .env and edit. .env is gitignored; this file is the reference for
# what may go in it.
#
# Every variable be/src/config.ts reads must appear here with a safe
# placeholder — be/test/env-example.test.ts fails if one does not, because a
# setting nobody can discover is one nobody uses. Uncomment only what you are
# actually changing: every commented line below shows the current default,
# unless its own comment says otherwise.
#
# Two things do NOT belong here:
#
#   Credentials. They live in ~/.config/rn/credentials, outside the install
#   tree, because this directory is replaced wholesale on upgrade and a token
#   in it would be deleted by one, silently. See docs/sec.md.
#
#   Anything the launcher sets — RN_ENV_SEALED, RN_RUNTIME_*, RN_INSTALL_DIR,
#   RN_NET_ALLOWLIST. Those are constructed for the child process and are not
#   yours to set; the launcher clears the environment before building it.

# --- Behaviour ------------------------------------------------------------

# Automation safety switch. Anything other than the exact string "false"
# means dry-run. Leave it on until a job is proven.
DRY_RUN=true

# error | warn | info | debug
LOG_LEVEL=info

# --- The socket -----------------------------------------------------------

# The API. Loopback by default, and rn refuses to start on a routable address
# without a second opt-in — the API has no authentication, so this address is
# the whole of that security position. See docs/network.md before changing it.
#BACKEND_HOST=127.0.0.1
#BACKEND_PORT=3010

# Permission to bind a routable address, and the one line here that is not a
# default: unset is the default, and the safe state. While it is unset rn
# refuses to start on anything but loopback. Setting it to exactly 1 lifts that
# refusal and nothing else — the API still has no authentication, so whatever
# stands in front of it is doing the whole job. Read docs/network.md first: a
# tunnel is almost always the better answer and needs none of this.
#RN_ALLOW_REMOTE=1

# The webhook listener, on its own port so a tunnel pointed at it cannot reach
# the API's mutating routes. See docs/network.md.
#BACKEND_HOOKS_PORT=3011

# The click tracker, on a third port. It is the one socket here that answers an
# unauthenticated stranger by design, so it is kept off the hooks listener —
# that port's security argument is that it serves one route and has no path to
# anything else. See docs/link-tracking.md.
#BACKEND_TRACKER_PORT=3012

# Origins the browser may call the API from. Replaces the list rather than
# extending it, so a packaged or proxied deployment can pin exactly one. CORS
# is a browser mechanism and not a security control — see docs/network.md.
#RN_CORS_ORIGIN=http://localhost:1790,http://127.0.0.1:1790

# --- Where state is kept --------------------------------------------------
#
# All six default to ~/.config/rn/. Never inside the install directory: that
# is replaced on upgrade, and losing settings or history to an upgrade is the
# same bug as losing them to a restart.

#RN_SETTINGS_PATH=/home/you/.config/rn/settings.json
#RN_HISTORY_PATH=/home/you/.config/rn/history.json
#RN_JOB_RUNS_PATH=/home/you/.config/rn/job-runs.json

# What a job remembers between runs — the cursor that tells new from
# already-seen. Delete it and the next run of a polling job treats everything
# as new; that is the supported way to make one report from scratch.
#RN_JOB_STATE_PATH=/home/you/.config/rn/job-state.json

# Webhooks made on Config → Jobs, as opposed to the ones declared in a job
# file. Losing this one is not like losing a cursor: it is a URL somebody
# else's system still POSTs to, which starts answering 404.
#RN_WEBHOOKS_PATH=/home/you/.config/rn/webhooks.json

# The credentials file. Values are never read from here by the backend — the
# launcher reads it and passes them in — but Config → Jobs writes it, so the
# path has to be nameable. No credential ever goes in this example file, and a
# test enforces that.
#RN_CREDENTIALS_PATH=/home/you/.config/rn/credentials

# Per-job settings changed on Config → Jobs — a schedule, a ceiling, where a
# job hands off — keyed by job id. It holds differences only: delete it and
# every job goes back to exactly what its own file declares, which is the
# property that makes editing one from a page safe to offer.
#RN_JOB_OVERRIDES_PATH=/home/you/.config/rn/job-overrides.json

# What an OAuth sign-in on Config → Connection left behind besides the token:
# the account, the scopes granted, and when the token dies. None of it is
# secret, which is why it is not in the credentials file — the token itself is.
#RN_OAUTH_PATH=/home/you/.config/rn/oauth.json

# Minted tracking links and the clicks that came back. JSONL, because unlike
# every other store here it is appended to by a request handler rather than
# rewritten when somebody presses save. See docs/link-tracking.md.
#RN_TRACKER_STORE_PATH=/home/you/.config/rn/link-tracking.jsonl

# The origin tracked links are minted against — what actually appears in the
# mail. The default is this machine's own tracker port, which is useless from
# anywhere else on purpose: a link to 127.0.0.1 fails visibly in a recipient's
# browser instead of silently pointing somewhere wrong. No trailing slash.
#
# This must be a domain you own, and rn refuses to mint against one it can tell
# is not: http, a bare IP, an explicit port, loopback, or a hostname under a
# suffix somebody lends out (*.ts.net, quick tunnels, ngrok). The last is the
# one worth pausing on — it works perfectly and then dies when the machine is
# renamed, taking every link ever sent with it. docs/link-tracking.md §3.
#
# This example was itself `https://example.ts.net/t` until the check landed.
#RN_TRACKER_BASE_URL=https://links.example.com/t

# Accept that the tracker's hostname is lent rather than owned — the *.ts.net
# name Funnel gives this machine. docs/link-tracking.md §3 option 3: free, no
# extra infrastructure, and permanent in the wrong direction, so it is
# defensible when every recipient already knows what rn is and not otherwise.
#
# It waives exactly one check. A borrowed hostname over http, or with a port in
# it, is still refused — those are different mistakes and this says nothing
# about them.
#RN_TRACKER_ACCEPT_BORROWED_HOSTNAME=1

# Which (send, recipient) pairs the send job has already attempted. Its own
# file rather than a section of the link store: links are pruned on a retention
# clock and these markers must outlive that, or a pruned send becomes sendable
# again — which would mean mailing everybody a second time.
#RN_TRACKER_SENT_PATH=/home/you/.config/rn/link-sends.jsonl

# The SMTP server the send job connects to, and the address it sends from.
# RN_SMTP_USER is both the From address and the SMTP username; the password is
# the gmailAppPassword credential and never goes here. 465 is implicit TLS —
# 587 opens in plaintext and upgrades, so a network that strips the upgrade
# leaves the session readable.
#RN_SMTP_HOST=smtp.gmail.com
#RN_SMTP_PORT=465

# Senders the read-mail job accepts mail from, one per line or comma-separated.
# "reports@example.com" is that address exactly; "example.com" or
# "@example.com" is anybody at that domain. Empty means every sender.
#
# It lives here rather than only on the job's run form because the scheduler
# supplies no inputs: an automatic run uses the job's declared defaults, so a
# filter typed on the form would be empty on every scheduled run. The form
# field overrides this for one run started by hand.
#RN_MAIL_ALLOWED_SENDERS=reports@example.com, @example.org

# The mail rules an install has made — which mailboxes to watch and what counts
# as interesting in each. Edited on Config → Mail; its own file rather than a
# section of settings.json, which holds scalar values and has no shape for a
# list of records.
#RN_MAIL_RULES_PATH=/home/you/.config/rn/mail-rules.json

# Where the last connection test is remembered, so a page can say when each
# half of the account last answered. Its own file rather than a settings key:
# settings hold what a person chose, and this holds what happened.
#RN_MAIL_TEST_PATH=/home/you/.config/rn/mail-test.json

# Recipients the read-mail job accepts mail to, matched against To and Cc. The
# counterpart of RN_MAIL_ALLOWED_SENDERS, and what makes watching a sent
# mailbox useful: there the sender is always you. Both apply when both are set,
# which is how "from me to her" is expressed.
#RN_MAIL_ALLOWED_RECIPIENTS=someone@example.com

# The name shown beside your address on mail rn sends: "Pieter <you@example.com>"
# rather than the address on its own. Empty is the default and sends the bare
# address. The only setting in this group whose effect is visible to somebody
# who is not running rn, and it cannot be corrected for mail already sent.
#RN_MAIL_FROM_NAME=Pieter

# The only addresses the send job may send to. Empty — the default — refuses
# every send, which is deliberate: a message in a stranger's mailbox is the one
# thing here no revert reaches, so an install says who it is willing to write to
# before it can write to anybody. An exact address, or a domain as a suffix.
#
# Not to be confused with RN_MAIL_ALLOWED_RECIPIENTS above, which is the
# opposite direction: that one narrows the To and Cc of mail that arrives.
#RN_SEND_ALLOWED_RECIPIENTS=someone@example.com

# Where replies should go, when that is not the sending account. Empty sets no
# header at all and replies come back to RN_MAIL_USER, which is right whenever
# one account both sends and reads.
#RN_MAIL_REPLY_TO=someone@example.com

# How long to wait between one message and the next. Zero sends as fast as the
# server allows, which is right for a short list. A long one is that many SMTP
# connections opened back to back, and a provider answering a burst with a 4xx
# makes rn retry the whole run — nothing is delivered twice, but pacing turns
# three attempts back into one.
#RN_SMTP_GAP_MS=0

# How long an SMTP socket may sit silent, and how long the connection may take
# to establish. The default is nodemailer's ten minutes, which is also the send
# job's own ceiling — so a silent socket reads as the job timing out rather than
# as the server having stopped answering. 60000 separates the two.
#RN_SMTP_TIMEOUT_MS=600000

# How long an IMAP socket may sit silent on a read-mail *run*. Not applied to
# the held-open watch connection, which exists to sit silent. The default is
# imapflow's five minutes, which is also read-mail's ceiling.
#RN_IMAP_TIMEOUT_MS=300000

# How many of the newest matching messages one read-mail run examines. This is
# the default for the job's input, so it is what a scheduled run uses. Read it
# together with the remembered-ids window: a run that examines more messages
# than the window holds pushes out ids it recorded in the same run, and the
# same mail is reported again later.
#RN_MAIL_MAX_MESSAGES=25

# Hold an IMAP connection open and read mail the moment it arrives, rather than
# waiting for the read-mail schedule. Off by default: it holds a connection all
# day and needs the credential at boot, so it is opted into rather than
# something that starts happening after an upgrade. The schedule keeps running
# as the backstop for anything missed while the connection was down.
#RN_MAIL_WATCH=1
# One connection each, comma-separated or one per line. A Gmail filter with
# "Skip the Inbox" means the message never touches INBOX, so watch the label
# too rather than instead.
#RN_MAIL_WATCH_MAILBOX=INBOX, Projects/rn

# The IMAP server the read-mail job polls. 993 is implicit TLS, the counterpart
# of SMTP's 465.
#RN_IMAP_HOST=imap.gmail.com
#RN_IMAP_PORT=993

# The account rn sends from and reads with — the address and the username for
# both. One setting because it is one account: the app-password path in
# docs/link-tracking.md §1 exists so a single opaque credential covers sending
# and reading, and a pair of user fields that must always match is a pair that
# can disagree.
#RN_MAIL_USER=you@example.com

# How long the tracker remembers *who*, in days — not how long a link lives.
# Links never expire, because one in somebody's mailbox may be clicked years
# later and a 404 there is a fault rather than lost analytics. What expires is
# the recipient recorded against a link, and the clicks themselves.
#RN_TRACKER_RETENTION_DAYS=90

# --- The watch-pages job --------------------------------------------------

# Where the watched pages are kept — one record per page: the URL, whether it
# is on, what noise to ignore on that page, and how often to check it. Made and
# edited on Config → Watching.
#
# Its own file rather than a setting, and it began as one: two comma-separated
# variables that could name the pages and the noise to ignore, but only as one
# answer for every page at once. An ignore list belongs to a page.
#RN_WATCH_PAGES_PATH=~/.config/rn/watch-pages.json

# --- The prune-profiles job -----------------------------------------------

# Where V8 drops its profiling artifacts. --cpu-prof and friends write into the
# current working directory, which is why that is the default.
#RN_PROFILE_DIR=.

# How long an artifact is kept. This is the installed default; a single run can
# name its own window on Monitor → Jobs without changing it.
#RN_PROFILE_MAX_AGE_DAYS=7
