# Copy to .env and edit. .env is gitignored; this file is the reference for
# what may go in it.
#
# Every variable be/src/config.ts reads must appear here with a safe
# placeholder — be/test/env-example.test.ts fails if one does not, because a
# setting nobody can discover is one nobody uses. Uncomment only what you are
# actually changing: every commented line below shows the current default,
# unless its own comment says otherwise.
#
# Two things do NOT belong here:
#
#   Credentials. They live in ~/.config/rn/credentials, outside the install
#   tree, because this directory is replaced wholesale on upgrade and a token
#   in it would be deleted by one, silently. See docs/sec.md.
#
#   Anything the launcher sets — RN_ENV_SEALED, RN_RUNTIME_*, RN_INSTALL_DIR,
#   RN_NET_ALLOWLIST. Those are constructed for the child process and are not
#   yours to set; the launcher clears the environment before building it.

# --- Behaviour ------------------------------------------------------------

# Automation safety switch. Anything other than the exact string "false"
# means dry-run. Leave it on until a job is proven.
DRY_RUN=true

# error | warn | info | debug
LOG_LEVEL=info

# --- The socket -----------------------------------------------------------

# The API. Loopback by default, and rn refuses to start on a routable address
# without a second opt-in — the API has no authentication, so this address is
# the whole of that security position. See docs/network.md before changing it.
#BACKEND_HOST=127.0.0.1
#BACKEND_PORT=3010

# Permission to bind a routable address, and the one line here that is not a
# default: unset is the default, and the safe state. While it is unset rn
# refuses to start on anything but loopback. Setting it to exactly 1 lifts that
# refusal and nothing else — the API still has no authentication, so whatever
# stands in front of it is doing the whole job. Read docs/network.md first: a
# tunnel is almost always the better answer and needs none of this.
#RN_ALLOW_REMOTE=1

# The webhook listener, on its own port so a tunnel pointed at it cannot reach
# the API's mutating routes. See docs/network.md.
#BACKEND_HOOKS_PORT=3011

# The click tracker, on a third port. It is the one socket here that answers an
# unauthenticated stranger by design, so it is kept off the hooks listener —
# that port's security argument is that it serves one route and has no path to
# anything else. See docs/link-tracking.md.
#BACKEND_TRACKER_PORT=3012

# Origins the browser may call the API from. Replaces the list rather than
# extending it, so a packaged or proxied deployment can pin exactly one. CORS
# is a browser mechanism and not a security control — see docs/network.md.
#RN_CORS_ORIGIN=http://localhost:1790,http://127.0.0.1:1790

# --- Where state is kept --------------------------------------------------
#
# All six default to ~/.config/rn/. Never inside the install directory: that
# is replaced on upgrade, and losing settings or history to an upgrade is the
# same bug as losing them to a restart.

#RN_SETTINGS_PATH=/home/you/.config/rn/settings.json
#RN_HISTORY_PATH=/home/you/.config/rn/history.json
#RN_JOB_RUNS_PATH=/home/you/.config/rn/job-runs.json

# What a job remembers between runs — the cursor that tells new from
# already-seen. Delete it and the next run of a polling job treats everything
# as new; that is the supported way to make one report from scratch.
#RN_JOB_STATE_PATH=/home/you/.config/rn/job-state.json

# Webhooks made on Config → Jobs, as opposed to the ones declared in a job
# file. Losing this one is not like losing a cursor: it is a URL somebody
# else's system still POSTs to, which starts answering 404.
#RN_WEBHOOKS_PATH=/home/you/.config/rn/webhooks.json

# The credentials file. Values are never read from here by the backend — the
# launcher reads it and passes them in — but Config → Jobs writes it, so the
# path has to be nameable. No credential ever goes in this example file, and a
# test enforces that.
#RN_CREDENTIALS_PATH=/home/you/.config/rn/credentials

# Per-job settings changed on Config → Jobs — a schedule, a ceiling, where a
# job hands off — keyed by job id. It holds differences only: delete it and
# every job goes back to exactly what its own file declares, which is the
# property that makes editing one from a page safe to offer.
#RN_JOB_OVERRIDES_PATH=/home/you/.config/rn/job-overrides.json

# Minted tracking links and the clicks that came back. JSONL, because unlike
# every other store here it is appended to by a request handler rather than
# rewritten when somebody presses save. See docs/link-tracking.md.
#RN_TRACKER_STORE_PATH=/home/you/.config/rn/link-tracking.jsonl

# How long the tracker remembers *who*, in days — not how long a link lives.
# Links never expire, because one in somebody's mailbox may be clicked years
# later and a 404 there is a fault rather than lost analytics. What expires is
# the recipient recorded against a link, and the clicks themselves.
#RN_TRACKER_RETENTION_DAYS=90

# --- The prune-profiles job -----------------------------------------------

# Where V8 drops its profiling artifacts. --cpu-prof and friends write into the
# current working directory, which is why that is the default.
#RN_PROFILE_DIR=.

# How long an artifact is kept. This is the installed default; a single run can
# name its own window on Monitor → Jobs without changing it.
#RN_PROFILE_MAX_AGE_DAYS=7
